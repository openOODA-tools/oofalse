// # Sovereign JSON Rendering Subsystem
//
// Logline: Formats machine-readable JSON payloads for failure metadata and exit code diagnostics.
//
// Setup: Pure string serialization routines conforming to RFC 8259 JSON format.
//
// Beats:
//   1. Escape strings for strict JSON conformance.
//   2. Format structured failure payloads with exit codes and error messages.
//   3. Format POSIX exit status metadata objects.
//   4. Format shell pipeline failure impact simulation models.

import "core/exit_codes.oo";
import "core/false_engine.oo";

fn json_str_escape(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let b: Int = byte_at(s, i);
        if b == 92 {
            out = out + "\\\\";
        } else if b == 34 {
            out = out + "\\\"";
        } else if b == 10 {
            out = out + "\\n";
        } else if b == 13 {
            out = out + "\\r";
        } else if b == 9 {
            out = out + "\\t";
        } else {
            out = out + str_slice(s, i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

fn render_failure_json(code: Int, msg: String) -> String {
    let name: String = exit_code_name(code);
    let cat: String = exit_code_category(code);
    let desc: String = exit_code_description(code);
    let is_sig: Bool = is_fatal_signal(code);
    let sig_val: Int = signal_number(code);

    let mut out: String = "{\n"
        + "  \"status\": \"failed\",\n"
        + "  \"success\": false,\n"
        + "  \"exit_code\": " + code.to_string() + ",\n"
        + "  \"symbol\": \"" + json_str_escape(name) + "\",\n"
        + "  \"category\": \"" + json_str_escape(cat) + "\",\n"
        + "  \"description\": \"" + json_str_escape(desc) + "\",\n"
        + "  \"is_fatal_signal\": " + if is_sig { "true" } else { "false" } + ",\n"
        + "  \"signal\": " + sig_val.to_string() + ",\n"
        + "  \"message\": \"" + json_str_escape(msg) + "\"\n"
        + "}\n";
    return out;
}

fn render_exit_code_json(code: Int) -> String {
    let name: String = exit_code_name(code);
    let cat: String = exit_code_category(code);
    let desc: String = exit_code_description(code);
    let is_sig: Bool = is_fatal_signal(code);
    let sig_val: Int = signal_number(code);

    let mut out: String = "{\n"
        + "  \"exit_code\": " + code.to_string() + ",\n"
        + "  \"symbol\": \"" + json_str_escape(name) + "\",\n"
        + "  \"category\": \"" + json_str_escape(cat) + "\",\n"
        + "  \"description\": \"" + json_str_escape(desc) + "\",\n"
        + "  \"is_fatal_signal\": " + if is_sig { "true" } else { "false" } + ",\n"
        + "  \"signal\": " + sig_val.to_string() + "\n"
        + "}\n";
    return out;
}

fn render_simulation_json(code: Int) -> String {
    let errexit: String = simulate_errexit(code);
    let sc_and: String = simulate_short_circuit_and(code);
    let sc_or: String = simulate_short_circuit_or(code);
    let pipefail: String = simulate_pipefail(code);
    let trap_err: String = simulate_trap_err(code);

    let mut out: String = "{\n"
        + "  \"exit_code\": " + code.to_string() + ",\n"
        + "  \"errexit\": \"" + json_str_escape(errexit) + "\",\n"
        + "  \"short_circuit_and\": \"" + json_str_escape(sc_and) + "\",\n"
        + "  \"short_circuit_or\": \"" + json_str_escape(sc_or) + "\",\n"
        + "  \"pipefail\": \"" + json_str_escape(pipefail) + "\",\n"
        + "  \"trap_err\": \"" + json_str_escape(trap_err) + "\"\n"
        + "}\n";
    return out;
}
