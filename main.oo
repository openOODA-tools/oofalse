// # oofalse Main Entry Point
//
// Logline: Sovereign NO-OP FAILURE utility with zero overhead, exit semantics, and streaming MCP.
//
// Setup: Demands explicit capability tokens &FsReadCap, &ProcessCap, and &EnvCap under zero ambient authority.
//
// Beats:
//   1. Parse command-line options and dispatch --help, --version, --test, or --mcp.
//   2. Route synthetic showcase requests for --demo and --explain execution.
//   3. Format and output structured failure diagnostics as text or JSON.
//   4. Deliver deterministic non-zero exit status (default: 1) under standard POSIX false semantics.

import "render/render_text.oo";
import "render/render_json.oo";
import "ipc/cli_options.oo";
import "ipc/mcp_server.oo";
import "anchor.oo";

pub fn main(
    fr: &FsReadCap,
    _pr: &ProcessCap,
    _env: &EnvCap,
    args: List[String]
) -> Int {
    let num_args: Int = list_len(args);
    let mut i: Int = 0;

    while i < num_args {
        let arg: String = list_get(args, i);
        if arg == "-h" || arg == "--help" {
            print(render_help());
            return 0;
        }
        if arg == "-v" || arg == "--version" {
            print(render_version());
            return 0;
        }
        if arg == "--test" {
            if run_all_tests() {
                print("oofalse: internal anchor tests PASSED\n");
                return 0;
            } else {
                print("oofalse: internal anchor tests FAILED\n");
                return 1;
            }
        }
        if arg == "--mcp" {
            run_mcp_server(fr);
            return 0;
        }
        i = i + 1;
    }

    let opts: FalseOpts = parse_cli_args(args);

    if opts.show_help {
        print(render_help());
        return 0;
    }
    if opts.show_version {
        print(render_version());
        return 0;
    }
    if opts.demo_mode {
        if opts.json_mode {
            print(render_simulation_json(opts.exit_code));
        } else {
            print(render_demo());
        }
        return opts.exit_code;
    }
    if opts.explain_mode {
        print(render_exit_code_table());
        return opts.exit_code;
    }
    if opts.json_mode {
        print(render_failure_json(opts.exit_code, opts.message));
        return opts.exit_code;
    }
    if chars_len(opts.message) > 0 {
        print("oofalse: " + opts.message + "\n");
        return opts.exit_code;
    }

    return opts.exit_code;
}
